# Copy this file to .env (cp .env.example .env) and fill in your own values.
# .env is git-ignored. Never commit it.
#
# These settings are only needed if you set RUN_LLM = True in 00_setup.ipynb.
# Retrieval works without any of them.

# --- Amazon Bedrock (the default provider) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# A Claude model you have enabled in Bedrock
BEDROCK_MODEL_ID=

# --- Or an OpenAI-compatible API (instead of Bedrock) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional ---
# Higher Hugging Face download limits for the embedding model
# HF_TOKEN=
# Keep the default: the indexes were built with this model
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Only if USE_SHARED_READONLY_CLUSTER = False (your own OpenSearch cluster) ---
# OPENSEARCH_HOST=
# OPENSEARCH_PORT=9200
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_SSL=true
# OPENSEARCH_VECTOR_RECIPES_BASELINE_INDEX=recipes-vector-baseline
# OPENSEARCH_BM25_RECIPES_BASELINE_INDEX=recipes-bm25-baseline
# OPENSEARCH_HYBRID_INDEX=recipes-hybrid
# OPENSEARCH_RECIPE_BM25_INDEX=recipes-bm25
# OPENSEARCH_RECIPE_VECTOR_INDEX=recipes-vector
# OPENSEARCH_AUDIT_INDEX=recipes-audit-log
