<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.a2a</groupId>
    <artifactId>a2a-kafka</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>A2A Kafka</name>
    <description>Kafka transport implementation of the Agent2Agent (A2A) protocol</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kafka.version>3.9.1</kafka.version>
        <jackson.version>2.16.1</jackson.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>demo</id>
                        <configuration>
                            <mainClass>com.example.a2a.kafka.Demo</mainClass>
                            <arguments><argument>producer.properties</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>consumer</id>
                        <configuration>
                            <mainClass>com.example.a2a.kafka.DemoConsumer</mainClass>
                            <arguments><argument>producer.properties</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>benchmark-agent</id>
                        <configuration>
                            <mainClass>com.example.a2a.kafka.benchmark.BenchmarkKafkaAgentMain</mainClass>
                            <arguments><argument>producer.properties</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>agent</id>
                        <configuration>
                            <mainClass>com.example.a2a.kafka.countdown.CountdownKafkaAgent</mainClass>
                            <arguments><argument>producer.properties</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>client</id>
                        <configuration>
                            <mainClass>com.example.a2a.kafka.countdown.KafkaCountdownClient</mainClass>
                            <arguments>
                                <argument>producer.properties</argument>
                                <argument>30</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>audit</id>
                        <configuration>
                            <mainClass>com.example.a2a.kafka.countdown.AuditEventConsumer</mainClass>
                            <arguments><argument>producer.properties</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>replay</id>
                        <configuration>
                            <mainClass>com.example.a2a.kafka.countdown.ReplayEventConsumer</mainClass>
                            <arguments>
                                <argument>producer.properties</argument>
                                <argument>15</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
