flowchart LR
  subgraph RR["1 — Request/response"]
    direction TB
    RR1["Client: produce message/send"]
    RR2["Agent: consume a2a.requests"]
    RR3["Agent: produce artifact-update"]
    RR4["Agent: produce status-update COMPLETED"]
    RR5["Agent: produce task snapshot"]
    RR6["Client: consume until terminal"]
    RR1 --> RR2 --> RR3 --> RR4 --> RR5 --> RR6
  end

  subgraph STR["2 — Streaming"]
    direction TB
    S1["Client: produce message/send"]
    S2["Agent: consume a2a.requests"]
    S3["Agent: produce status-update WORKING"]
    S4["Agent: produce multiple artifact-update chunks"]
    S5["Agent: produce status-update COMPLETED"]
    S6["Client: consume events in order"]
    S1 --> S2 --> S3 --> S4 --> S5 --> S6
  end

  subgraph NTF["3 — Notifications"]
    direction TB
    N1["Client: produce message/send"]
    N2["Agent: consume a2a.requests"]
    N3["Agent: produce status-update WORKING"]
    N4["Agent: produce artifact-update"]
    N5["Agent: produce status-update COMPLETED"]
    N6["Client: consume async updates"]
    N1 --> N2 --> N3 --> N4 --> N5 --> N6
  end

  RR ~~~ STR ~~~ NTF

  subgraph NOTE["Kafka notify ≠ HTTP webhook"]
    direction TB
    N7["HTTP: agent POSTs to client webhook URL"]
    N8["Kafka: client consumes a2a.updates or reply topic"]
  end

  classDef phase fill:#eef3f8,color:#111,stroke:#3b4d63,stroke-width:1px;
  classDef accent fill:#fff3e0,color:#5d4037,stroke:#ef6c00,stroke-width:1px;
  class RR1,RR2,RR3,RR4,RR5,RR6,S1,S2,S3,S4,S5,S6,N1,N2,N3,N4,N5,N6 phase;
  class N7,N8 accent;
