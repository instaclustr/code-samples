    D1["d-01 :8105"]
    D2["d-02 :8106"]
    D3["d-03 :8107"]
    D4["d-04 :8108"]
  end

  SIM["SimDrone + local autonomy<br/>hold · auto-RTB · reject stale patch"]

  VIZ[("replay.json<br/>snapshot.png")]

  MC --> SM1 --> AC
